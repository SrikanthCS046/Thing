// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

enum UserRole {
  SUPER_ADMIN
  USER
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ConnectorType {
  GOOGLE_DRIVE
  GITHUB
  NOTION
  CONFLUENCE
  JIRA
  SLACK
  SHAREPOINT
  POSTGRESQL
}

enum ConnectorStatus {
  DISCONNECTED
  CONNECTED
  SYNCING
  ERROR
}

enum KnowledgeSummaryKind {
  DOCUMENT
  WORKSPACE
  CONNECTOR
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             UserRole  @default(USER)
  isActive         Boolean   @default(true)
  emailVerified    Boolean   @default(false)
  refreshTokenHash String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organizations        OrganizationMember[]
  workspaces           WorkspaceMember[]
  createdOrganizations Organization[]       @relation("OrganizationCreator")
  createdWorkspaces    Workspace[]          @relation("WorkspaceCreator")
  uploadedDocuments    Document[]           @relation("DocumentUploader")
  conversations        Conversation[]
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("OrganizationCreator", fields: [createdById], references: [id])

  members       OrganizationMember[]
  workspaces    Workspace[]
  documents     Document[]
  conversations Conversation[]
  connectors    Connector[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userId         String
  organizationId String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String
  createdById    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("WorkspaceCreator", fields: [createdById], references: [id])

  members       WorkspaceMember[]
  documents     Document[]
  conversations Conversation[]
  connectors    Connector[]
  knowledgeSummaries KnowledgeSummary[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspaceId String
  userId      String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Document {
  id             String         @id @default(cuid())
  name           String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  status         DocumentStatus @default(PENDING)
  errorMessage   String?
  metadata       Json?
  organizationId String
  workspaceId    String
  uploadedById   String
  connectorId    String?
  externalId     String?
  contentHash    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User              @relation("DocumentUploader", fields: [uploadedById], references: [id])
  connector    Connector?        @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  versions     DocumentVersion[]
  chunks       DocumentChunk[]
  syncItems    ConnectorSyncItem[]
  knowledgeSummary KnowledgeSummary?

  @@unique([connectorId, externalId])
  @@index([workspaceId, status])
  @@index([organizationId])
}

model Connector {
  id               String          @id @default(cuid())
  name             String
  type             ConnectorType
  status           ConnectorStatus @default(DISCONNECTED)
  /// Non-secret config (repo, folder id, db name). Secrets stay in env/secret store later.
  config           Json            @default("{}")
  lastSyncedAt     DateTime?
  syncCursor       String?
  lastError        String?
  organizationId   String
  workspaceId      String
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents    Document[]
  syncItems    ConnectorSyncItem[]
  knowledgeSummary KnowledgeSummary?

  @@index([workspaceId])
  @@index([organizationId, type])
}

model ConnectorSyncItem {
  id                 String    @id @default(cuid())
  connectorId        String
  documentId         String?
  externalId         String
  externalUpdatedAt  DateTime?
  contentHash        String?
  lastSyncedAt       DateTime?
  deletedAt          DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([connectorId, externalId])
  @@index([connectorId, lastSyncedAt])
}

model KnowledgeSummary {
  id             String               @id @default(cuid())
  kind           KnowledgeSummaryKind
  title          String
  summary        String
  sourceHash     String?
  /// Stored via raw SQL as pgvector for retrieval participation.
  embedding      Unsupported("vector(1536)")?
  organizationId String
  workspaceId    String
  documentId     String?              @unique
  connectorId    String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document   Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  connector  Connector? @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@index([organizationId])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  version       Int      @default(1)
  contentHash   String?
  extractedText String?
  createdAt     DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model DocumentChunk {
  id             String                       @id @default(cuid())
  documentId     String
  organizationId String
  workspaceId    String
  content        String
  chunkIndex     Int
  pageNumber     Int?
  tokenCount     Int?
  /// Stored via raw SQL as pgvector; Prisma maps as Unsupported.
  embedding      Unsupported("vector(1536)")?
  metadata       Json?
  createdAt      DateTime                     @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([workspaceId])
  @@index([organizationId])
}

model Conversation {
  id             String   @id @default(cuid())
  title          String?
  organizationId String
  workspaceId    String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  summary      ConversationSummary?

  @@index([workspaceId, userId])
}

model ConversationSummary {
  id                     String   @id @default(cuid())
  conversationId         String   @unique
  summary                String
  /// Number of messages covered by this rolling summary.
  messageCountAtSummary  Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  citations      Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     MessageFeedback[]

  @@index([conversationId])
}

enum FeedbackRating {
  UP
  DOWN
}

model MessageFeedback {
  id               String         @id @default(cuid())
  rating           FeedbackRating
  comment          String?
  retrievedChunks  Json?
  userId           String
  workspaceId      String
  conversationId   String
  messageId        String
  createdAt        DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([workspaceId, createdAt])
  @@index([conversationId])
}

model LlmUsageEvent {
  id               String   @id @default(cuid())
  provider         String
  model            String
  operation        String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float    @default(0)
  requestDurationMs Int     @default(0)
  userId           String?
  organizationId   String?
  workspaceId      String?
  conversationId   String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([model, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  resourceType   String
  resourceId     String?
  userId         String?
  organizationId String?
  workspaceId    String?
  ip             String?
  userAgent      String?
  correlationId  String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([correlationId])
}

model RetrievalQueryLog {
  id             String   @id @default(cuid())
  workspaceId    String
  organizationId String?
  userId         String?
  query          String
  topK           Int
  resultCount    Int
  latencyMs      Int
  createdAt      DateTime @default(now())

  @@index([workspaceId, createdAt])
}

model EvaluationRun {
  id             String   @id @default(cuid())
  name           String
  datasetVersion String
  metrics        Json
  details        Json?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
