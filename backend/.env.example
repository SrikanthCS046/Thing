PORT=7000
NODE_ENV=development

APP_NAME=VedaFlux
APP_VERSION=1.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memora

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

STORAGE_ROOT=./storage
EMBEDDING_DIMENSIONS=1536
AI_SERVICE_URL=http://127.0.0.1:8001

# AI service
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# GitHub connector defaults (connector JSON may override owner/repo)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_API_VERSION=2022-11-28

# Jira Cloud connector defaults
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Slack connector default
SLACK_BOT_TOKEN=
